# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15550100000
# Public hostname that Twilio can reach (ngrok in development), no scheme:
PUBLIC_HOST=your-subdomain.ngrok-free.app
# Secret used to sign the per-call token embedded in TwiML (any long random string):
SESSION_TOKEN_SECRET=change-me-to-a-long-random-string

# --- Model access ---
# openrouter (default) | gemini
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
# Fastest tool-reliable model measured on this conversation (Sept 2026): ~0.9 s on tool turns vs 2.3 s for Gemini 3.8 Flash, 6 s for Claude Sonnet 5.
# Compare others with: npm run bench -- --models openai/gpt-5.6-luna,google/gemini-3.8-flash --persona eligible --n 2
OPENROUTER_MODEL=openai/gpt-5.6-luna
# none | minimal | low | medium | high  (low keeps replies fast; Gemini via OpenRouter rejects none)
OPENROUTER_REASONING_EFFORT=low
# latency | throughput | price
OPENROUTER_PROVIDER_SORT=latency

# Only needed when LLM_PROVIDER=gemini (direct Google AI Studio access)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low

# --- Laptop voice mode (http://localhost:PORT/local), no Twilio needed ---
# Deepgram (Flux turn detection) and Cartesia (voice). Both have free tiers.
DEEPGRAM_API_KEY=
# cartesia | elevenlabs. Empty: Cartesia when CARTESIA_API_KEY is set, else ElevenLabs.
# Only the laptop page; phone calls always use ELEVENLABS_VOICE through Twilio.
TTS_PROVIDER=
# Cartesia free plan: 20K characters a month (roughly 10-15 test calls), 2 at a time.
CARTESIA_API_KEY=
# Katie (US English, female). Others: Skylar db6b0ed5-d5d3-463d-ae85-518a07d3c2b4, Jameson (male) a5136bf9-224c-4d76-b823-52bd5efcffcc.
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
# sonic-2 and sonic-turbo stop working on 2026-10-20.
CARTESIA_MODEL_ID=sonic-3.6

# Only with TTS_PROVIDER=elevenlabs:
ELEVENLABS_API_KEY=
# The voice/model are parsed from ELEVENLABS_VOICE below. If that voice id is not in your
# ElevenLabs library, override here (ElevenLabs premade ids: Sarah EXAVITQu4vr4xnSDxMaL, Brian nPczCjzI2devNBz1zQrb, Matilda XrExE9yKIg1WjnnlVkGX).
ELEVENLABS_VOICE_ID=
# turbo has clearly better prosody than flash for only ~40 ms more latency; v3 is not available on the streaming socket for free tiers.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
LOCAL_OUTPUT_CSV=data/local_results.csv
LOCAL_SAMPLE_RATE=24000
# Optional Flux eager end-of-turn threshold (0.3-0.9); leave unset for now.
LOCAL_EAGER_EOT_THRESHOLD=

# --- Voice (ElevenLabs via Twilio ConversationRelay) ---
# Format: <VoiceID>-<model>-<speed>_<stability>_<similarity>
# Default voice: Juniper (aMSt68OGf4xUZAnLpTU8), a Voice Library voice. With TTS_PROVIDER=elevenlabs, laptop mode calls ElevenLabs
# with your own key, and free ElevenLabs plans cannot use library voices over the API; on a free plan set ELEVENLABS_VOICE_ID to a premade voice.
ELEVENLABS_VOICE=aMSt68OGf4xUZAnLpTU8-flash_v2_5-1.0_0.5_0.75
# Deepgram Flux end-of-turn confidence threshold (0.5-0.9). Lower = snappier, higher = fewer cut-offs.
EOT_THRESHOLD=0.7
# high | medium | low
INTERRUPT_SENSITIVITY=medium

# --- Screening & storage ---
QUESTIONNAIRE_PATH=config/questionnaire.yaml
OUTPUT_CSV=data/screening_results.csv
TRANSCRIPTS_DIR=data/calls
RECORD_CALLS=false

# --- Admin panel & call analytics (/admin) ---
# Without a token the panel only answers on localhost. Set one (12+ chars) to open it through a tunnel;
# visit /admin?token=<token> once and a cookie keeps you signed in.
ADMIN_TOKEN=
# Model for post-call analysis; defaults to OPENROUTER_MODEL (or GEMINI_MODEL).
ANALYSIS_MODEL=
ANALYSIS_DIR=data/analysis

# --- Storage ---
# Unset: transcripts, results CSVs and analyses are files under data/ (paths above).
# Set: they live in this Postgres database instead (needed on hosts whose disk is wiped, e.g. Render free).
# Neon's free plan works: use its pooled connection string.
DATABASE_URL=

# --- Dialing guards ---
# Twilio trial accounts cannot run ConversationRelay; the server refuses to dial from one unless this is true.
ALLOW_TRIAL_CALLS=false
MAX_CONCURRENT_CALLS=2
# Local-time window in which calls may be placed (HH:MM-HH:MM), evaluated in the contact's timezone
CALL_WINDOW_LOCAL=09:00-20:00
DEFAULT_TIMEZONE=America/New_York

# --- Server ---
PORT=3000
LOG_LEVEL=info
